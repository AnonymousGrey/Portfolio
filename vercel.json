{
  "headers": [
    {
      "source": "/(.*)\\.(pdf)$",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=certificate.pdf"
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
